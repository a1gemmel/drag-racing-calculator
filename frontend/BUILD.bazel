package(default_visibility = ["//:__subpackages__"])

load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@@aspect_rules_js~~npm~npm__typescript__5.6.3//frontend:package_json.bzl", tsc_binary = "tsc_binary")
load("@@aspect_rules_js~~npm~npm__vite__5.4.10//frontend:package_json.bzl", vite_binary = "vite_binary")

npm_link_all_packages(name = "node_modules")

tsc_binary(name = "tsc")
vite_binary(name = "vite")

filegroup(
    name = "sources",
    srcs = glob([
        "*.json",
        "*.ts",
        "*.tsx",
        "src/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.css",
        "index.html",
    ]),
)

js_run_binary(
    name = "bundle",
    tool = ":vite",
    srcs = [":sources", ":node_modules"],
    args = ["build", "--outDir", "dist"],
    chdir = "frontend",
    out_dirs = ["dist"],
)

genrule(
    name = "standalone",
    srcs = [":bundle"],
    outs = ["static/index.html"],
    cmd = "cp $(location :bundle)/index.html $@",
)

sh_test(
    name = "static_artifact_test",
    srcs = ["static_artifact_test.sh"],
    args = ["$(location :standalone)"],
    data = [":standalone"],
    size = "small",
)