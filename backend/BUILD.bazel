package(default_visibility = ["//:__subpackages__"])

py_library(
    name = "calculations",
    srcs = ["calculations.py"],
)

py_binary(
    name = "server",
    srcs = ["app.py"],
    data = ["//frontend:bundle"],
    env = {
        "FRONTEND_DIST": "$(location //frontend:bundle)",
    },
    deps = [
        ":calculations",
        "@python_deps//fastapi:pkg",
        "@python_deps//uvicorn:pkg",
    ],
    main = "app.py",
)

filegroup(
    name = "sources",
    srcs = glob(["*.py"]),
)